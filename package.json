{
  "name": "nalloc",
  "description": "Rust-like Option and Result for TypeScript with near-zero allocations for extreme performance",
  "version": "0.5.5",
  "type": "module",
  "types": "build/index.d.ts",
  "main": "build/index.cjs",
  "module": "build/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./build/index.cjs",
      "import": "./build/index.js"
    },
    "./types": {
      "require": "./build/types.cjs",
      "import": "./build/types.js"
    },
    "./option": {
      "require": "./build/option.cjs",
      "import": "./build/option.js"
    },
    "./result": {
      "require": "./build/result.cjs",
      "import": "./build/result.js"
    },
    "./schema": {
      "require": "./build/schema.cjs",
      "import": "./build/schema.js"
    },
    "./safe": {
      "require": "./build/safe.cjs",
      "import": "./build/safe.js"
    },
    "./unsafe": {
      "require": "./build/unsafe.cjs",
      "import": "./build/unsafe.js"
    },
    "./iter": {
      "require": "./build/iter.cjs",
      "import": "./build/iter.js"
    },
    "./nonempty": {
      "require": "./build/nonempty.cjs",
      "import": "./build/nonempty.js"
    },
    "./http": {
      "require": "./build/http.cjs",
      "import": "./build/http.js"
    },
    "./eslint": {
      "require": "./build/eslint.cjs",
      "import": "./build/eslint.js"
    },
    "./codemod": {
      "require": "./build/codemod.cjs",
      "import": "./build/codemod.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nalloc-codemod": "./build/codemod-cli.js"
  },
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.check.json",
    "build": "rm -rf build && inop src build -i __tests__ -i *.tmp.ts && tsc --declaration --emitDeclarationOnly",
    "lint": "oxlint",
    "format": "prettier --check .",
    "test": "vitest run",
    "bench": "overtake benchmarks/* --pin-cores -w 1 --progress",
    "bench:save": "pnpm bench --save-baseline .bench-baseline.json",
    "bench:test": "pnpm bench --compare-baseline .bench-baseline.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3axap4eHko/nalloc.git"
  },
  "keywords": [
    "option",
    "result",
    "maybe",
    "either",
    "ok",
    "err",
    "some",
    "none",
    "nonempty",
    "non-empty-array",
    "unwrap",
    "rust",
    "typescript",
    "type-safe",
    "monad",
    "functional",
    "algebraic-data-types",
    "discriminated-union",
    "sum-type",
    "error-handling",
    "null-safety",
    "pattern-matching",
    "do-notation",
    "generator",
    "pipe",
    "iterator",
    "railway-oriented-programming",
    "schema-validation",
    "zero-allocation",
    "zero-cost",
    "gc-friendly",
    "performance",
    "lightweight",
    "tree-shakeable",
    "neverthrow-alternative",
    "fp-ts-alternative",
    "effect-alternative",
    "oxide-ts-alternative",
    "ts-results-alternative",
    "true-myth-alternative"
  ],
  "author": "Ivan Zakharchanka",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/3axap4eHko/nalloc/issues"
  },
  "homepage": "https://github.com/3axap4eHko/nalloc#readme",
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8",
    "@typescript-eslint/utils": ">=8",
    "eslint": ">=9",
    "oxc-parser": ">=0.135.0",
    "typescript": ">=4.8.4"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "@typescript-eslint/utils": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript-eslint/rule-tester": "^8.63.0",
    "@typescript-eslint/utils": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "inop": "^0.9.4",
    "overtake": "^2.1.1",
    "oxc-parser": "^0.139.0",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "tsafe": "^1.8.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0"
}
